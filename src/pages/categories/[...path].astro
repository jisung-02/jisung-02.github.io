---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryIndex from '../../components/CategoryIndex.astro';
import { isVisible, sortByDate, buildCategoryTree, flattenCategoryNodes, postsUnder } from '../../lib/posts';

export async function getStaticPaths() {
  const all = await getCollection('posts');
  const posts = all.filter((p) => isVisible(p.data, import.meta.env.PROD));
  const nodes = flattenCategoryNodes(buildCategoryTree(posts));
  return nodes.map((n) => ({
    params: { path: n.path.join('/') },
    props: { path: n.path, posts: sortByDate(postsUnder(posts, n.path)) },
  }));
}

const { path, posts } = Astro.props;
const fmt = (d: Date) => d.toISOString().slice(0, 10);
// 브레드크럼: 각 세그먼트를 누적 경로 링크로
const crumbs = path.map((seg, i) => ({ seg, href: `/categories/${path.slice(0, i + 1).join('/')}` }));
---
<BaseLayout title={`${path[path.length - 1]} · jisung-02`}>
  <div class="index-layout">
    <CategoryIndex activePath={path} />
    <div class="index-main">
      <h1 class="breadcrumb">
        {crumbs.map((c, i) => (
          <>
            {i > 0 && <span class="sep">›</span>}
            {i === crumbs.length - 1 ? <span>{c.seg}</span> : <a href={c.href}>{c.seg}</a>}
          </>
        ))}
      </h1>
      <ul class="post-list">
        {posts.map((p) => (
          <li>
            <div class="meta">{fmt(p.data.date)}</div>
            <a class="title marker" href={`/posts/${p.id}`}>{p.data.title}</a>
            {p.data.description && <p>{p.data.description}</p>}
          </li>
        ))}
      </ul>
    </div>
  </div>
</BaseLayout>
