---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { isVisible, sortByDate } from '../lib/posts';

const all = await getCollection('posts');
const posts = sortByDate(all.filter((p) => isVisible(p.data, import.meta.env.PROD)));
const fmt = (d: Date) => d.toISOString().slice(0, 10);
const site = Astro.site?.href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'jisung-02',
  description: '학부생의 CS 학습 정리 노트 — 기계학습·운영체제·네트워크·클라우드 인프라 등.',
  url: site,
  inLanguage: 'ko-KR',
  author: { '@type': 'Person', name: 'jisung-02', url: site },
  blogPost: posts.slice(0, 20).map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    url: site ? new URL(`/posts/${p.id}/`, site).href : undefined,
    datePublished: p.data.date.toISOString(),
  })),
};
---
<BaseLayout title="jisung-02" jsonLd={jsonLd}>
  <header class="masthead">
    <p class="eyebrow">Lab Notebook</p>
    <h1>jisung-02</h1>
    <p class="lede">학부생의 CS 학습 정리 노트.</p>
    <p class="ledger">기록 {posts.length}개 · 최근 갱신 {posts.length > 0 ? fmt(posts[0].data.date) : '—'}</p>
  </header>
  <ul class="post-list">
    {posts.map((p) => (
      <li>
        <div class="meta">{fmt(p.data.date)}</div>
        <a class="title marker" href={`/posts/${p.id}`}>{p.data.title}</a>
        {p.data.description && <p>{p.data.description}</p>}
      </li>
    ))}
  </ul>
</BaseLayout>
