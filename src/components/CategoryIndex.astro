---
import { getCollection } from 'astro:content';
import { isVisible, buildCategoryTree, withFullCategory } from '../lib/posts';
import CatTree from './CatTree.astro';

interface Props { activePath?: string[] }
const { activePath = [] } = Astro.props;

const all = withFullCategory(await getCollection('posts'));
const tree = buildCategoryTree(all.filter((p) => isVisible(p.data, import.meta.env.PROD)));
const total = tree.reduce((s, n) => s + n.count, 0);
---
<aside class="cat-index">
  <p class="eyebrow">Index</p>
  <ul class="cat-tree cat-all">
    <li>
      <a class:list={['cat-link', { active: activePath.length === 0 }]} href="/archive/">
        전체 <span class="count">{total}</span>
      </a>
    </li>
  </ul>
  <CatTree nodes={tree} activePath={activePath} />
</aside>
