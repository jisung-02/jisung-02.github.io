{
  "name": "portfolio-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "verify": "npm run lint && npm run typecheck && npm run test && npm run check-content",
    "lint": "tsx scripts/lint.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "check-content": "tsx scripts/check-content.ts",
    "build": "tsx scripts/build.ts",
    "audit": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2"
  }
}
