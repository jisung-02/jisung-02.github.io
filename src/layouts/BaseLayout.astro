---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
interface Props { title: string; description?: string; ogType?: string; jsonLd?: unknown; }
const {title,description='jisung-02의 공부 노트와 개인 기록.',ogType='website',jsonLd}=Astro.props;
const current=Astro.url.pathname;
const active=(href:string)=>href==='/'?current==='/':current.startsWith(href);
const canonical=new URL(current,Astro.site).href;
---
<!doctype html>
<html lang="ko">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title.endsWith('jisung-02')?title:`${title} · jisung-02`}</title>
<meta name="description" content={description} /><meta name="theme-color" content="#ffffff" />
<link rel="canonical" href={canonical} /><link rel="icon" href="/favicon.svg" />
<meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content={ogType} /><meta property="og:url" content={canonical} /><meta property="og:site_name" content="jisung-02" /><meta property="og:locale" content="ko_KR" />
<meta name="twitter:card" content="summary" />
<link rel="alternate" type="application/rss+xml" title="jisung-02" href="/rss.xml" />
{jsonLd&&<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd).replace(/</g,'\\u003c')} />}
<script is:inline>try{const t=localStorage.getItem('margin-theme')??localStorage.getItem('theme');document.documentElement.dataset.theme=t||(matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light')}catch{}</script>
<script type="module" src="/app.js" is:inline></script>
<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token":"68684dd037e64de389401c9e7706ee47"}'></script>
</head>
<body>
<a class="skip" href="#main">본문으로 건너뛰기</a>
<div class="shell">
<header class="topbar">
<a class="wordmark" href="/" aria-label="jisung-02 홈">jisung-02<span class="brand-note">notes</span></a>
<details class="site-menu" open><summary aria-label="메뉴 열기 또는 닫기"><span>Menu</span><span class="menu-icon" aria-hidden="true"></span></summary>
<nav aria-label="주 메뉴">
{[['/','Posts'],['/archive/','Archive'],['/about/','About']].map(([url,label])=><a href={url} class:list={{active:active(url)}} aria-current={active(url)?'page':undefined}>{label}</a>)}
<form class="nav-search" role="search" action="/archive/" method="get"><input type="search" name="q" aria-label="글 검색" placeholder="Search…" autocomplete="off" /><button type="submit" aria-label="검색">↵</button></form>
<button class="theme-toggle" aria-label="어두운 테마" aria-pressed="false" title="테마 전환">◐</button>
</nav></details>
</header>
<main id="main"><slot /></main>
<footer class="footer"><div><b>jisung-02</b><span>notes</span></div><div>© {new Date().getFullYear()} jisung-02 · <a href="/tags/">Tags</a> · <a href="/rss.xml">RSS</a> · <a href="https://github.com/jisung-02">GitHub</a></div></footer>
</div>
</body></html>
