---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  {
    name: 'SIP Mutation Fuzzer',
    period: '2025 — 2026',
    description: 'VoLTE/IMS 환경에서 SIP 메시지를 변형해 단말의 취약점을 탐지하는 퍼징 시스템',
    stack: 'Python · SIP/IMS · Open5GS · srsRAN · Kamailio',
    links: [{ label: 'GitHub ↗', href: 'https://github.com/jisung-02/sip-mutation-fuzzer' }],
  },
  {
    name: 'RCP — Return Cloud Platform',
    period: '2025.12 — 현재',
    description: '동아리 구성원을 위한 OpenStack 기반 사설 클라우드 플랫폼',
    stack: 'Go · Gin · ent · OpenStack · systemd · GitHub Actions',
    links: [{ label: 'GitHub ↗', href: 'https://github.com/KHU-RETURN/rcp-server' }],
  },
  {
    name: 'Aether',
    period: '2025',
    description: 'Gleam으로 작성한 서버 프레임워크와 학습용 네트워킹 스택',
    stack: 'Gleam · Erlang/BEAM · TCP/UDP · HTTP',
    links: [{ label: 'GitHub ↗', href: 'https://github.com/jisung-02/aether' }],
  },
  {
    name: 'NUVO',
    period: '2025',
    description: '전화 상황을 연습하는 AI 통화 트레이닝 서비스',
    stack: 'Python · gRPC · LangGraph · Kotlin/Spring · Elixir · STT/TTS',
    links: [],
  },
  {
    name: '사랑에 은퇴란 없다',
    period: '2024.10 — 2024.11',
    description: '체레미마카와 함께한 중장년층 사랑 인식 개선 캠페인의 인터랙티브 전시. 삐삐 숫자 메시지를 입력하고 해석하는 웹 체험을 구현했습니다.',
    stack: 'React · Redux · JavaScript',
    links: [
      { label: 'GitHub ↗', href: 'https://github.com/jisung-02/stale_LNR' },
      { label: '체레미마카 소개 글 ↗', href: 'https://cheremimaka.com/article/blog/8/36923/' },
    ],
  },
];

const skills = [
  { label: '주로 사용', items: 'Go · Python · Django/DRF · Linux · Docker' },
  { label: '프로젝트', items: 'FastAPI · Spring · TypeScript · OpenStack · GitHub Actions' },
  { label: '데이터', items: 'PostgreSQL · Redis · MongoDB · Elasticsearch' },
  { label: '네트워크', items: 'TCP · WebSocket · gRPC · SIP/IMS' },
  { label: '연구·실험', items: 'Open5GS · srsRAN · Kamailio · Elixir · Gleam · WebAssembly' },
];
---
<BaseLayout title="Portfolio · jisung-02" description="보안, 네트워크, 서버 개발에 관심이 있는 채지성의 프로젝트와 경력.">
  <header class="masthead">
    <p class="eyebrow">Portfolio</p>
    <h1>채지성</h1>
    <p class="lede">보안, 네트워크, 서버 개발에 관심이 있습니다.</p>
    <p class="ledger">AlpacaX 백엔드팀 · 경희대학교 컴퓨터공학과 졸업</p>
  </header>

  <section class="pf-section" aria-labelledby="experience-heading">
    <p class="eyebrow">Experience</p>
    <h2 id="experience-heading">경력</h2>
    <article class="pf-item">
      <div class="pf-heading"><h3 class="pf-name">AlpacaX · 정규직</h3><span class="pf-period">2026.01.01 — 현재</span></div>
      <p class="pf-description">Software Engineer · 백엔드팀</p>
    </article>
    <article class="pf-item">
      <div class="pf-heading"><h3 class="pf-name">AlpacaX · 계약직</h3><span class="pf-period">2025.06.23 — 2025.12.31</span></div>
      <p class="pf-description">백엔드팀</p>
    </article>
    <article class="pf-item">
      <div class="pf-heading"><h3 class="pf-name">AlpacaX · 인턴</h3><span class="pf-period">2024.12.23 — 2025.06.22</span></div>
      <p class="pf-description">백엔드팀 · 학교 현장실습</p>
    </article>
  </section>

  <section class="pf-section" aria-labelledby="projects-heading">
    <p class="eyebrow">Projects</p>
    <h2 id="projects-heading">프로젝트</h2>
    {projects.map((project) => (
      <article class="pf-item">
        <div class="pf-heading"><h3 class="pf-name">{project.name}</h3><span class="pf-period">{project.period}</span></div>
        <p class="pf-description">{project.description}</p>

        <p class="pf-tech">{project.stack}</p>
        {project.links.length > 0 && <div class="pf-links">{project.links.map((link) => <a href={link.href}>{link.label}</a>)}</div>}
      </article>
    ))}
  </section>

  <section class="pf-section" aria-labelledby="research-heading">
    <p class="eyebrow">Research</p>
    <h2 id="research-heading">보안 연구</h2>
    <article class="pf-item">
      <div class="pf-heading"><h3 class="pf-name">Ash Framework</h3><span class="pf-period">2026.08</span></div>
      <p class="pf-description">Elixir Ash Framework · CVE 3건 · Reporter: jisung-02</p>
      <ul class="p-points pf-cves">
        <li><a href="https://github.com/ash-project/ash/security/advisories/GHSA-3gq3-9xm3-c8v3">CVE-2026-67579 ↗</a><span>키셋 커서의 필터 표현식 주입 — 데이터 계층에 따라 SQL 인젝션 또는 코드 실행</span></li>
        <li><a href="https://github.com/ash-project/ash/security/advisories/GHSA-j35q-v8h8-7mwq">CVE-2026-69659 ↗</a><span>키셋 커서 역직렬화에 의한 메모리 고갈</span></li>
        <li><a href="https://github.com/ash-project/ash/security/advisories/GHSA-vvp6-3wv6-833j">CVE-2026-70395 ↗</a><span>관계 조회 조건 주입에 의한 비밀 조회 키 노출</span></li>
      </ul>

    </article>
  </section>

  <section class="pf-section" aria-labelledby="skills-heading">
    <p class="eyebrow">Skills</p>
    <h2 id="skills-heading">기술</h2>
    <dl class="stack">{skills.map((row) => <div class="stack-row"><dt>{row.label}</dt><dd>{row.items}</dd></div>)}</dl>
  </section>

  <section class="pf-section" aria-labelledby="education-heading">
    <p class="eyebrow">Education</p>
    <h2 id="education-heading">학력</h2>
    <article class="pf-item">
      <div class="pf-heading"><h3 class="pf-name">경희대학교</h3><span class="pf-period">2021.03 — 2026.08</span></div>
      <p class="pf-description">컴퓨터공학과 졸업</p>
      <p class="pf-tech">GPA 3.797 / 4.3 (4.08 / 4.5)</p>
    </article>
  </section>

  <section class="pf-section" aria-labelledby="awards-heading">
    <p class="eyebrow">Awards &amp; Scholarships</p>
    <h2 id="awards-heading">수상 · 장학</h2>
    <article class="pf-item">
      <div class="pf-heading"><h3 class="pf-name">KCC2026 학부생부문 최우수상</h3><span class="pf-period">2026.07</span></div>
      <p class="pf-description">VoLTE 단말의 SIP 취약점 탐지를 위한 무선 퍼징 시스템 연구</p>
      <p class="pf-tech">한국정보과학회 · 제1저자</p>
    </article>
    <article class="pf-item">
      <div class="pf-heading"><h3 class="pf-name">국가우수이공계 장학생</h3><span class="pf-period">2025</span></div>
      <p class="pf-tech">한국장학재단 · 재학 중 우수자</p>
    </article>
    <article class="pf-item">
      <div class="pf-heading"><h3 class="pf-name">Blaybus MVP 해커톤 최우수상</h3><span class="pf-period">2024.08</span></div>
      <p class="pf-description">치매 환자용 알약 디스펜서의 앱·서버 개발</p>
    </article>
    <article class="pf-item">
      <div class="pf-heading"><h3 class="pf-name">경기도 평화 두드림 청년 아이디어톤 우수상</h3><span class="pf-period">2024.06</span></div>
      <p class="pf-description">탈북 청년의 사회 정착을 돕는 커뮤니티 플랫폼 기획</p>
    </article>
  </section>

  <section class="pf-section" aria-labelledby="certificates-heading">
    <p class="eyebrow">Qualifications</p>
    <h2 id="certificates-heading">자격 · 평가</h2>
    <div class="pf-item"><div class="pf-heading"><h3 class="pf-name">TOPCIT</h3><span class="pf-period">2026.05</span></div><p class="pf-tech">수준 4 · 680 / 1000</p></div>
    <div class="pf-item"><div class="pf-heading"><h3 class="pf-name">정보처리기사</h3><span class="pf-period">2025.12</span></div></div>
    <div class="pf-item"><div class="pf-heading"><h3 class="pf-name">SQLD</h3><span class="pf-period">2024.12</span></div></div>
  </section>

  <section class="pf-section" aria-labelledby="activities-heading">
    <p class="eyebrow">Activities</p>
    <h2 id="activities-heading">활동</h2>
    <article class="pf-item"><div class="pf-heading"><h3 class="pf-name">경희대학교 운영체제 SW멘토</h3><span class="pf-period">2025.03 — 2025.06</span></div></article>
    <article class="pf-item"><div class="pf-heading"><h3 class="pf-name">RETURN 신입생 Python 교육</h3><span class="pf-period">2025.03 — 2025.06</span></div></article>
    <article class="pf-item"><div class="pf-heading"><h3 class="pf-name">경희고등학교 C++ 교육 멘토</h3><span class="pf-period">2024.09 — 2024.12</span></div></article>
    <article class="pf-item"><div class="pf-heading"><h3 class="pf-name">학술동아리 RETURN 회장</h3><span class="pf-period">2024.03 — 2024.08</span></div></article>
  </section>

  <section class="pf-section" aria-labelledby="contact-heading">
    <p class="eyebrow">Contact</p>
    <h2 id="contact-heading">연락처</h2>
    <div class="pf-links"><a href="mailto:jschae02@khu.ac.kr">Email ↗</a><a href="https://github.com/jisung-02">GitHub ↗</a><a href="https://www.linkedin.com/in/지성-채-6a98a4320/">LinkedIn ↗</a></div>
  </section>
</BaseLayout>
