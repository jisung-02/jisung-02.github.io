---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isVisible, categoryPath } from '../../lib/posts';

export async function getStaticPaths() {
  const all = await getCollection('posts');
  return all
    .filter((p) => isVisible(p.data, import.meta.env.PROD))
    .map((p) => ({ params: { id: p.id }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) => d.toISOString().slice(0, 10);
const catSegs = categoryPath(post.data.category);
const catCrumbs = catSegs.map((seg, i) => ({ seg, href: `/categories/${catSegs.slice(0, i + 1).join('/')}` }));
---
<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="post">
    <aside class="rail">
      {catCrumbs.length > 0 && (
        <div class="meta rail-cat">
          {catCrumbs.map((c, i) => (
            <>
              {i > 0 && <span class="sep">›</span>}
              <a href={c.href}>{c.seg}</a>
            </>
          ))}
        </div>
      )}
      <div class="meta">{fmt(post.data.date)}</div>
      {post.data.updated && <div class="meta">수정 {fmt(post.data.updated)}</div>}
      {post.data.tags.length > 0 && (
        <ul class="tags">
          {post.data.tags.map((t) => <li><a class="marker" href={`/tags/${t}`}>#{t}</a></li>)}
        </ul>
      )}
    </aside>
    <div class="post-body">
      <h1>{post.data.title}</h1>
      <Content />
    </div>
  </article>
</BaseLayout>
