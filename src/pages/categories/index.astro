---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isVisible, collectCategories } from '../../lib/posts';

const all = await getCollection('posts');
const posts = all.filter((p) => isVisible(p.data, import.meta.env.PROD));
const tree = collectCategories(posts);
---
<BaseLayout title="카테고리 · jisung-02">
  <p class="eyebrow">Categories</p>
  <h1>카테고리</h1>
  <ul class="cat-tree">
    {tree.map((c) => (
      <li>
        <a class="cat-parent" href={`/categories/${c.parent}`}>{c.parent} <span class="count">{c.count}</span></a>
        {c.children.length > 0 && (
          <ul>
            {c.children.map((ch) => (
              <li>
                <a class="cat-child marker" href={`/categories/${c.parent}/${ch.child}`}>{ch.child} <span class="count">{ch.count}</span></a>
              </li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ul>
</BaseLayout>
